# Copy to studio/.env for local Studio development.
# Everything here is compiled into the Studio bundle, which is publicly
# downloadable — so never put secrets in this file. The sync secret is typed
# into the sync tool by the operator and kept in their browser's localStorage.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Where the "Sincronizar vehículos desde Sheet" tool sends its request. This is
# the deployed site's API route, which holds the Google credentials server-side.
# Defaults to http://localhost:3000/api/sync-vehicles when unset.
SANITY_STUDIO_SYNC_ENDPOINT=https://e-virexion.evirexion.workers.dev/api/sync-vehicles
