{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "e-virexion",
	"compatibility_date": "2026-07-16",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "e-virexion"
		}
	],
	// Published price guide. Written by /api/prices/publish when someone clicks
	// "Publicar precios en la web" in the Google Sheet; read by /prices.
	// Also holds the magazine page images under "revista:<edición>:<página>".
	"kv_namespaces": [
		{
			"binding": "PRICES_KV",
			"id": "32a0489d6b1e42bbaf709a1ce68c59b6"
		}
	],
	// Reader accounts for the magazine portal (users, sessions, email tokens).
	// No id needed: `wrangler deploy` creates the database on first deploy, and
	// the app creates its tables on first use.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "evirexion-cuentas"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}