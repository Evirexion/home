{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "e-virexion",
	"compatibility_date": "2026-07-16",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "e-virexion"
		}
	],
	// Published price guide. Written by /api/prices/publish when someone clicks
	// "Publicar precios en la web" in the Google Sheet; read by /prices.
	// No id needed: `wrangler deploy` creates the namespace on first deploy.
	"kv_namespaces": [
		{
			"binding": "PRICES_KV"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}