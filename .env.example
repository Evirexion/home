# Copy to .env.local for local development.
# Leave the Sanity variables unset to run entirely on the bundled mock data
# in src/data/*.

# --- Sanity (News/Innovations CMS + station & price content) ---
# Create a free project at https://www.sanity.io/manage, then set:
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only token with "Editor" access, used by the internal news
# submission form (src/app/(site)/news/internal) to create draft documents.
# Create one at https://www.sanity.io/manage -> API -> Tokens.
SANITY_API_WRITE_TOKEN=

# --- Internal news draft area (simple password gate) ---
INTERNAL_NEWS_PASSWORD=
# Random string used to sign the internal-access cookie, e.g. `openssl rand -hex 32`
INTERNAL_NEWS_SESSION_SECRET=

# --- Contact form (Contáctanos tab) ---
# Create a key at https://resend.com/api-keys. Leave unset and the form will
# show a graceful "not configured yet" error instead of crashing.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Defaults to Resend's shared test
# sender (onboarding@resend.dev) if unset, which only works for testing.
CONTACT_FROM_EMAIL="E-VIREXION <onboarding@resend.dev>"

# --- Vehicle price sync (private Google Sheet -> Sanity) ---
# See docs/google-sheets-sync.md for the full setup walkthrough.
#
# The service account's JSON key file, either pasted raw or base64-encoded
# (base64 is recommended for Cloudflare secrets — it avoids newline and
# quoting problems). SERVER-ONLY: this never reaches the browser or the
# Studio bundle, which is why the sync runs through /api/sync-vehicles.
GOOGLE_SERVICE_ACCOUNT_KEY=

# The master vehicle sheet, and the tab (gid) inside it. The sheet stays
# private — it is shared directly with the service account's email.
VEHICLES_SPREADSHEET_ID=1cS6Fbuh3_GxGaczSV9ZI_AcJ94C1R-loHZ7XUz_DzFs
VEHICLES_SHEET_GID=1865210025

# Shared secret the Studio's sync button sends as a bearer token.
# Generate with `openssl rand -hex 32`.
VEHICLE_SYNC_SECRET=

# Optional: comma-separated origins allowed to call the sync endpoint (e.g.
# your Studio URL). Defaults to "*", which is safe here because the endpoint
# is gated on VEHICLE_SYNC_SECRET rather than on cookies.
VEHICLE_SYNC_ALLOWED_ORIGINS=
